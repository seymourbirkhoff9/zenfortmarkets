# Copy to backend/.env and fill in. Never commit the real file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

RESEND_API_KEY=re_XXXX            # re_XXXX = log emails instead of sending
# Until your domain is verified in Resend, use onboarding@resend.dev (Resend then only delivers to YOUR address)
EMAIL_FROM=Zenfort Markets <no-reply@zenfortmarkets.online>
EMAIL_REPLY_TO=support@zenfortmarkets.online
SUPPORT_EMAIL=support@zenfortmarkets.online
DEV_OUTBOX=false                     # true locally to see sent emails at /api/dev/outbox (never in production)

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000   # used for links in emails (production: https://zenfortmarkets.vercel.app, later https://zenfortmarkets.online)
# Extra allowed origins for direct API calls (defaults already cover localhost, Vercel and zenfortmarkets.online)
# ALLOWED_ORIGINS=http://localhost:3000,https://zenfortmarkets.vercel.app,https://zenfortmarkets.online,https://www.zenfortmarkets.online
COOKIE_SECURE=false                  # true in production (HTTPS)

# Optional
REQUIRE_KYC_FOR_WITHDRAWAL=true
REFERRAL_BONUS_AMOUNT=10.00
ENABLE_SCHEDULER=true                # hourly ROI accrual inside the API process
